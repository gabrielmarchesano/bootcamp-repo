{
  "title": "PostCardCapture",
  "description": "Captura (liquidação) de uma autorização. Pode diferir do autorizado (gorjeta, combustível). capture_id dá idempotência.",
  "type": "object",
  "properties": {
    "capture_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "authorization_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "amount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000000000
    }
  },
  "required": ["capture_id", "authorization_id", "amount"],
  "additionalProperties": false
}
