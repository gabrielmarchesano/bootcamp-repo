{
  "title": "PostTedTransfer",
  "description": "TED de saída. Sem schedule_date, sai agora (dentro da janela do STR); com schedule_date, fica agendada para um dia útil futuro.",
  "type": "object",
  "properties": {
    "target_account": {
      "type": "object",
      "properties": {
        "ispb": {
          "type": "string",
          "pattern": "^\\d{8}$"
        },
        "branch": {
          "type": "string",
          "pattern": "^\\d{1,4}$"
        },
        "number": {
          "type": "string",
          "pattern": "^\\d{1,20}$"
        },
        "digit": {
          "type": "string",
          "pattern": "^\\d$"
        },
        "document": {
          "type": "string",
          "pattern": "^(\\d{11}|\\d{14})$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "account_type": {
          "enum": ["CHECKING", "SALARY", "SAVINGS", "PAYMENT"]
        }
      },
      "required": ["ispb", "branch", "number", "document", "name", "account_type"],
      "additionalProperties": false
    },
    "amount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000000000
    },
    "schedule_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
  },
  "required": ["target_account", "amount"],
  "additionalProperties": false
}
