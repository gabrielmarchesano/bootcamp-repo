{
  "title": "PostTransfer",
  "description": "TEF (entre contas deste banco). Pix e TED têm rotas próprias por trilho, aninhadas na conta, como na QI.",
  "type": "object",
  "properties": {
    "source_account_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "method": {
      "enum": ["TEF"]
    },
    "amount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000000000
    },
    "destination": {
      "type": "object",
      "properties": {
        "account_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "required": ["account_id"],
      "additionalProperties": false
    }
  },
  "required": ["source_account_id", "method", "amount", "destination"],
  "additionalProperties": false
}
