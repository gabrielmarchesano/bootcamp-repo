{
  "title": "PostWebhookSpi",
  "description": "Mensagem do SPI (mock). Sprint 2a: só RECEIVED (PIX recebido). CONFIRMED e REJECTED entram com o PIX de saída.",
  "type": "object",
  "properties": {
    "event": {
      "enum": ["RECEIVED"]
    },
    "external_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9]+$"
    },
    "amount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000000000
    },
    "destination_account": {
      "type": "object",
      "properties": {
        "branch": { "type": "string", "pattern": "^\\d{4}$" },
        "number": { "type": "string", "pattern": "^\\d{1,20}$" }
      },
      "required": ["branch", "number"],
      "additionalProperties": false
    },
    "sender": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 255 },
        "document": { "type": "string", "pattern": "^(\\d{11}|\\d{14})$" },
        "ispb": { "type": "string", "pattern": "^\\d{8}$" }
      },
      "required": ["name", "document", "ispb"],
      "additionalProperties": false
    }
  },
  "required": ["event", "external_id", "amount", "destination_account", "sender"],
  "additionalProperties": false
}
