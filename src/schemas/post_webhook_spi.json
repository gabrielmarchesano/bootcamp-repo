{
  "title": "PostWebhookSpi",
  "description": "Mensagem do SPI (mock). RECEIVED: Pix recebido (REVERSAL = devolução de um Pix nosso). SETTLED/REJECTED: desfecho de um Pix que enviamos. Campos extras são aceitos: a QI avisa que webhook não deve ser mapeado de forma restritiva.",
  "type": "object",
  "properties": {
    "event": {
      "enum": [
        "RECEIVED",
        "SETTLED",
        "REJECTED"
      ]
    },
    "external_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9]+$"
    },
    "amount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000000000
    },
    "destination_account": {
      "type": "object",
      "properties": {
        "branch": {
          "type": "string",
          "pattern": "^\\d{4}$"
        },
        "number": {
          "type": "string",
          "pattern": "^\\d{1,20}$"
        }
      },
      "required": [
        "branch",
        "number"
      ]
    },
    "sender": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "document": {
          "type": "string",
          "pattern": "^(\\d{11}|\\d{14})$"
        },
        "ispb": {
          "type": "string",
          "pattern": "^\\d{8}$"
        }
      },
      "required": [
        "name",
        "document",
        "ispb"
      ]
    },
    "pix_transfer_type": {
      "enum": [
        "KEY",
        "MANUAL",
        "STATIC_QR_CODE",
        "DYNAMIC_QR_CODE",
        "REVERSAL"
      ]
    },
    "receiver_pix_key": {
      "type": "string",
      "maxLength": 77
    },
    "pix_message": {
      "type": "string",
      "maxLength": 140
    },
    "original_end_to_end_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "end_to_end_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "error_code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20
    },
    "error_description": {
      "type": "string",
      "maxLength": 255
    }
  },
  "required": [
    "event"
  ],
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "properties": {
          "event": {
            "const": "RECEIVED"
          }
        }
      },
      "then": {
        "required": [
          "external_id",
          "amount",
          "destination_account",
          "sender"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "event": {
            "const": "SETTLED"
          }
        }
      },
      "then": {
        "required": [
          "end_to_end_id"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "event": {
            "const": "REJECTED"
          }
        }
      },
      "then": {
        "required": [
          "end_to_end_id",
          "error_code"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "pix_transfer_type": {
            "const": "REVERSAL"
          }
        },
        "required": [
          "pix_transfer_type"
        ]
      },
      "then": {
        "required": [
          "original_end_to_end_id"
        ]
      }
    }
  ]
}