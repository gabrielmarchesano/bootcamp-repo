{
  "title": "PostWebhookStr",
  "description": "Mensagem do STR (mock). RECEIVED: TED recebida. SETTLED/RETURNED: desfecho de uma TED que enviamos. Campos extras são aceitos: a QI avisa que webhook não deve ser mapeado de forma restritiva.",
  "type": "object",
  "properties": {
    "event": {
      "enum": [
        "RECEIVED",
        "SETTLED",
        "RETURNED"
      ]
    },
    "external_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9]+$"
    },
    "amount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000000000
    },
    "destination_account": {
      "type": "object",
      "properties": {
        "branch": {
          "type": "string",
          "pattern": "^\\d{4}$"
        },
        "number": {
          "type": "string",
          "pattern": "^\\d{1,20}$"
        }
      },
      "required": [
        "branch",
        "number"
      ]
    },
    "sender": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "document": {
          "type": "string",
          "pattern": "^(\\d{11}|\\d{14})$"
        },
        "ispb": {
          "type": "string",
          "pattern": "^\\d{8}$"
        }
      },
      "required": [
        "name",
        "document",
        "ispb"
      ]
    },
    "str_control_number": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "reason": {
      "type": "string",
      "maxLength": 255
    }
  },
  "required": [
    "event"
  ],
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "properties": {
          "event": {
            "const": "RECEIVED"
          }
        }
      },
      "then": {
        "required": [
          "external_id",
          "amount",
          "destination_account",
          "sender"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "event": {
            "const": "SETTLED"
          }
        }
      },
      "then": {
        "required": [
          "str_control_number"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "event": {
            "const": "RETURNED"
          }
        }
      },
      "then": {
        "required": [
          "str_control_number"
        ]
      }
    }
  ]
}
