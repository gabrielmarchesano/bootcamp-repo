{
  "title": "PostCardRefund",
  "description": "Estorno de uma compra capturada. A soma dos estornos não passa do capturado (conferido no controller). refund_id dá idempotência.",
  "type": "object",
  "properties": {
    "refund_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "authorization_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "amount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000000000
    }
  },
  "required": ["refund_id", "authorization_id", "amount"],
  "additionalProperties": false
}
