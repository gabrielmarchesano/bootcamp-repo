{
  "title": "PostCustomer",
  "description": "Cadastro de cliente + abertura de conta. Documentos só com dígitos. Valores em centavos.",
  "type": "object",
  "properties": {
    "cpf": {
      "type": "string",
      "pattern": "^\\d{11}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "birth_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "type": {
      "enum": ["INDIVIDUAL", "MEI"]
    },
    "cnpj": {
      "type": "string",
      "pattern": "^\\d{14}$"
    },
    "annual_revenue": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100000000000
    },
    "is_pep": {
      "type": "boolean"
    }
  },
  "required": ["cpf", "name", "birth_date", "type", "annual_revenue"],
  "additionalProperties": false,
  "if": {
    "properties": { "type": { "const": "MEI" } },
    "required": ["type"]
  },
  "then": {
    "required": ["cnpj"]
  },
  "else": {
    "not": { "required": ["cnpj"] }
  }
}
