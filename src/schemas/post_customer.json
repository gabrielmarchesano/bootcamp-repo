{
  "title": "PostCustomer",
  "description": "Cadastro de titular (v7) + abertura de conta. Documento só com dígitos (CPF 11 / CNPJ 14). Valores em centavos.",
  "type": "object",
  "properties": {
    "person_type": {
      "enum": ["NATURAL", "LEGAL"]
    },
    "document": {
      "type": "string",
      "pattern": "^\\d{11}$|^\\d{14}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "birth_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "legal_nature": {
      "enum": ["EI", "SLU", "LTDA"]
    },
    "owner_customer_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "annual_revenue": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100000000000
    },
    "is_pep": {
      "type": "boolean"
    }
  },
  "required": ["person_type", "document", "name", "annual_revenue"],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": { "person_type": { "const": "NATURAL" } },
        "required": ["person_type"]
      },
      "then": {
        "required": ["birth_date"],
        "not": { "anyOf": [
          { "required": ["legal_nature"] },
          { "required": ["owner_customer_id"] }
        ] }
      },
      "else": {
        "required": ["legal_nature"],
        "not": { "anyOf": [
          { "required": ["birth_date"] },
          { "required": ["is_pep"] }
        ] }
      }
    },
    {
      "if": {
        "properties": { "legal_nature": { "const": "EI" } },
        "required": ["legal_nature"]
      },
      "then": {
        "required": ["owner_customer_id"]
      },
      "else": {
        "not": { "required": ["owner_customer_id"] }
      }
    }
  ]
}
